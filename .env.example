# Copy this file to a file named ".env" (in this same folder) and fill it in.
# `firebase deploy` uploads .env with the server, so only non-secret settings
# go here. Don't put GEMINI_API_KEY or PORT in this file: the deploy will refuse.
#
# On Firebase, Gemini is reached through Vertex AI in this project: no key is
# needed, and it's billed on the project's normal Google Cloud billing.

# ── Google sign-in and Drive picker ───────────────────────────────────────
# The same three values you used on Vercel. GOOGLE_CLIENT_ID alone turns on
# "Sign in with Google"; all three also turn on "From Google Drive".
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
GOOGLE_APP_ID=

# ── Optional ──────────────────────────────────────────────────────────────
# Vertex AI model (if it isn't available, Visor tries newer/older Flash models)
# VERTEX_MODEL=gemini-3.1-flash-lite
# To use a Gemini API key instead of Vertex AI (stored with
# `firebase functions:secrets:set GEMINI_API_KEY`):
# GEMINI_VIA=apikey
# GEMINI_MODEL=gemini-3.1-flash-lite-preview
# Shown on /privacy as the contact address
CONTACT_EMAIL=

# ── Running on your own computer (npm start) ──────────────────────────────
# Put these in a separate file named ".env.local". It is never uploaded.
#   GEMINI_API_KEY=your-key
#   SESSION_SECRET=any-long-random-string
