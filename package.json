{
  "name": "visor",
  "version": "7.0.0",
  "description": "Visor Classroom: writing sessions, research, citations, group projects and class discussions, with the whole process visible to the teacher.",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/*.test.js\"",
    "sync-engine": "node scripts/sync-engine.js",
    "predeploy": "node scripts/sync-engine.js && node scripts/vendor.js",
    "deploy": "firebase deploy",
    "logs": "firebase functions:log",
    "vendor": "node scripts/vendor.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "diff": "^9.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^11.1.0",
    "on-headers": "^1.1.0",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": "24"
  },
  "devDependencies": {
    "quill": "2.0.3"
  }
}
