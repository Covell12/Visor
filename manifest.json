{
  "manifest_version": 3,
  "name": "Visor — Writing Sessions & Google Docs History",
  "short_name": "Visor",
  "version": "4.2.1",
  "description": "Visor Classroom companion: records research in writing sessions, cites pages in one click, shows who wrote what in Google Docs.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "webNavigation",
    "contextMenus",
    "declarativeNetRequest",
    "alarms",
    "activeTab"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "host_permissions": [
    "https://docs.google.com/document/*",
    "https://docs.google.com/presentation/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*",
        "https://docs.google.com/presentation/*"
      ],
      "js": [
        "page-probe.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "aware.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://docs.google.com/document/*",
        "https://docs.google.com/presentation/*"
      ],
      "js": [
        "changelog.js",
        "shares.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "https://visor-ed.web.app/*",
        "https://visor-ed.firebaseapp.com/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Visor — Writing Sessions & Google Docs History",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "cite-page": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Cite this page with Visor"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "logo.png",
        "replay.html",
        "replay.js",
        "replay.css",
        "glass.css",
        "theme.js"
      ],
      "matches": [
        "https://docs.google.com/*"
      ]
    },
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "blocked.css",
        "logo.png",
        "config.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
